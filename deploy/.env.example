# ====================================================================
# journalAI — deployment environment
# Copy to deploy/.env and fill in. Never commit deploy/.env.
# ====================================================================

# Domain: public hostname (Caddy provisions HTTPS via Let's Encrypt).
# Set to "localhost" for HTTP-only dev. Production: e.g. journal.example.com
DOMAIN=localhost

# Initial password for the single user. Change later via /settings.
APP_PASSWORD=CHANGE_ME

# === 64-hex secrets — generate each ONCE via: openssl rand -hex 32 ===
DB_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS_0000000000000000000000000000000000
SESSION_SECRET=CHANGE_ME_64_HEX_CHARACTERS_0000000000000000000000000000000000
SECRET_KEY_WRAP=CHANGE_ME_64_HEX_CHARACTERS_0000000000000000000000000000000000

# Session timeouts
SESSION_IDLE_MINUTES=10
SESSION_ABSOLUTE_HOURS=12

# Max audio upload size (MB)
MAX_UPLOAD_MB=25

# === AI endpoints — OpenAI-compatible URLs ===
# STT (Whisper)
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Chat
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-4o-mini

# Embeddings (reserved for Phase 2 — semantic search)
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# TTS (reserved for Phase 3 — read-aloud)
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1

# Path inside backend container where the SQLCipher DB lives.
# Mounted from ../data/ on the host.
DB_PATH=/app/data/journal.db

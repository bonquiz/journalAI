# ====================================================================
# journalAI — deployment environment
# Copy to deploy/.env and fill in. Never commit deploy/.env.
# ====================================================================

# Domain: public hostname (Caddy provisions HTTPS via Let's Encrypt).
# Set to "localhost" for HTTP-only dev. Production: e.g. journal.example.com
DOMAIN=localhost

# Initial password for the single user. Change later via /settings.
# Must be ≥12 chars and not on the banned-default list (CHANGE_ME, password,
# admin, testpw, …). Generate with: openssl rand -base64 18
APP_PASSWORD=CHANGE_ME

# === 64-hex secrets — generate each ONCE via: openssl rand -hex 32 ===
DB_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARACTERS_0000000000000000000000000000000000
SESSION_SECRET=CHANGE_ME_64_HEX_CHARACTERS_0000000000000000000000000000000000
SECRET_KEY_WRAP=CHANGE_ME_64_HEX_CHARACTERS_0000000000000000000000000000000000

# Session timeouts
SESSION_IDLE_MINUTES=20
SESSION_ABSOLUTE_HOURS=12

# Max audio upload size (MB)
MAX_UPLOAD_MB=25

# === AI endpoints — OpenAI-compatible URLs ===
# Resolution chain per capability: DB override (/settings) → values below →
# shared OPENAI_API_KEY (when *_API_KEY is empty AND base_url hits api.openai.com)
# → built-in OpenAI default model (when *_MODEL is empty AND base_url hits
# api.openai.com). Minimum setup for all-OpenAI: fill only OPENAI_API_KEY;
# everything else can stay blank.
# For non-OpenAI endpoints (Ollama, LocalAI, …) you must set base_url and model
# explicitly — there are no defaults for third-party servers.
OPENAI_API_KEY=

# STT (Whisper) — default model: whisper-1
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
STT_MODEL=whisper-1

# Chat — default model: gpt-4o-mini
CHAT_BASE_URL=https://api.openai.com/v1
CHAT_API_KEY=
CHAT_MODEL=gpt-4o-mini

# Embeddings — used by semantic search; default model: text-embedding-3-small
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_API_KEY=
EMBED_MODEL=text-embedding-3-small

# TTS (read-aloud) — default model: tts-1
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=
TTS_MODEL=tts-1

# Path inside backend container where the SQLCipher DB lives.
# Mounted from ../data/ on the host.
DB_PATH=/app/data/journal.db

# External docker network an upstream gateway (Cloudflare Tunnel, Traefik,
# nginx-proxy, …) uses to reach journalai-caddy. Leave blank and uncomment the
# caddy ports: block in docker-compose.yml if you want direct host binding.
# COMPOSE_GATEWAY_NETWORK=gateway

# Set when HTTPS is terminated by an upstream tunnel/proxy, so Caddy serves
# plain HTTP (otherwise it tries to auto-provision a TLS cert and 308-redirects
# to HTTPS, which loops behind a tunnel). Leave unset for standalone deploys.
# CADDY_SCHEME=http://

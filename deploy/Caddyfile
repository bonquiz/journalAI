# HTTPS is terminated by the upstream gateway (Cloudflare Tunnel, Traefik,
# nginx-proxy, …) when ${TLS_MODE} is "off". For standalone deployments
# remove the `http://` prefix so Caddy obtains a Let's Encrypt certificate.
{$CADDY_SCHEME:http://}{$DOMAIN} {
    encode gzip

    log {
        output stdout
        format console
    }

    handle /api/* {
        # API responses must never be cached by the browser — auth state
        # depends on live Set-Cookie + Session handling, and any cached 3xx
        # from a past misconfiguration turns into a permanent redirect loop.
        header Cache-Control "no-store"
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:8080
    }
}
